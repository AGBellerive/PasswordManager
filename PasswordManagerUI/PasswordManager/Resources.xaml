<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PrimaryBlue">#C4E3F5</Color>
    <Color x:Key="HomeScreenBlue">#FF64B4DD</Color>

    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlue}" />
    <SolidColorBrush x:Key="HomeScreenBlueBrush" Color="{StaticResource HomeScreenBlue}" />

    <FontFamily x:Key="LabelFont">Consolas</FontFamily>

</ResourceDictionary>