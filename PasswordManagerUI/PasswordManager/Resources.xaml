<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Color x:Key="PrimaryBlue">#C4E3F5</Color>
    <Color x:Key="HomeScreenBlue">#FF64B4DD</Color>
    <Color x:Key="SecondaryColor">#4B3F72</Color>
    <!-- 64b4dd -->

    <Color x:Key="NeurtralButtonColor">#FFA69E</Color>
    <Color x:Key="PositiveButtonColor">#8ACB88</Color>
    <Color x:Key="NegativeButtonColor">#A30000</Color>

    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlue}" />
    <SolidColorBrush x:Key="HomeScreenBlueBrush" Color="{StaticResource HomeScreenBlue}" />
    <SolidColorBrush x:Key="SecondaryColorBrush" Color="{StaticResource SecondaryColor}" />
                     
    <SolidColorBrush x:Key="NeurtralButtonBrush" Color="{StaticResource NeurtralButtonColor}" />
    <SolidColorBrush x:Key="PositiveButtonBrush" Color="{StaticResource PositiveButtonColor}" />
    <SolidColorBrush x:Key="NegativeButtonBrush" Color="{StaticResource NegativeButtonColor}" />
    
    
    <FontFamily x:Key="UniversalFont">Segoe UI Semibold</FontFamily>


</ResourceDictionary>