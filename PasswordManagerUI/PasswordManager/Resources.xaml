<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Color x:Key="PrimaryBlue">#C4E3F5</Color>
    <Color x:Key="HomeScreenBlue">#FF64B4DD</Color>
    <Color x:Key="SecondaryColor">#4B3F72</Color>
    <!-- 64b4dd -->

    <Color x:Key="NeurtralButtonColor">#FFA69E</Color>
    <Color x:Key="PositiveButtonColor">#8ACB88</Color>
    <Color x:Key="NegativeButtonColor">#A30000</Color>

    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlue}" />
    <SolidColorBrush x:Key="HomeScreenBlueBrush" Color="{StaticResource HomeScreenBlue}" />
    <SolidColorBrush x:Key="SecondaryColorBrush" Color="{StaticResource SecondaryColor}" />
                     
    <SolidColorBrush x:Key="NeurtralButtonBrush" Color="{StaticResource NeurtralButtonColor}" />
    <SolidColorBrush x:Key="PositiveButtonBrush" Color="{StaticResource PositiveButtonColor}" />
    <SolidColorBrush x:Key="NegativeButtonBrush" Color="{StaticResource NegativeButtonColor}" />
    
    
    <FontFamily x:Key="UniversalFont">Segoe UI Semibold</FontFamily>

    <Style x:Key="TextBoxTheme" TargetType="TextBox">
        <Setter Property="Background" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Height" Value="37"/>
        <Setter Property="Width" Value="240"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="{StaticResource HomeScreenBlueBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontFamily" Value="{StaticResource UniversalFont}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ReturnButton" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="675,10,0,0"/>
        <Setter Property="Width" Value="117"/>
        <Setter Property="Height" Value="31"/>
        <Setter Property="Background" Value="{StaticResource NeurtralButtonBrush}"/>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource UniversalFont}"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>

    <Style x:Key="PageTheme" TargetType="Page">
        <Setter Property="Height" Value="525"/>
        <Setter Property="Width" Value="810"/>
    </Style>

    <Style x:Key="ScrollViewerTheme" TargetType="ScrollViewer">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Height" Value="145"/>
        <Setter Property="Width" Value="240"/>
        <Setter Property="Margin" Value="553,333,0,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>


</ResourceDictionary>